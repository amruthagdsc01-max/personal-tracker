# Required in production: a long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me
# Optional: PostgreSQL URL from your host. Leave unset to use a local SQLite file.
# DATABASE_URL=postgresql://user:password@host:5432/ezze
# Optional: set to false to close sign-ups after you have made your account
ALLOW_SIGNUP=true
